        "schemaType": "manual",
        "inputSchema": "={\n  \"type\": \"object\",\n  \"properties\": {\n    \"Name\": {\n      \"type\": \"string\"\n    },\n    \"Email\": {\n      \"type\": \"string\"\n    },\n    \"Phone\": {\n      \"type\": \"string\"\n    },\n    \"Skills\": {\n      \"type\": \"string\"\n    },\n    \"Education\": {\n      \"type\": \"string\"\n    },\n    \"Experience\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"Name\",\n    \"Email\",\n    \"Phone\",\n    \"Skills\",\n    \"Education\",\n    \"Experience\"\n  ]\n}"
