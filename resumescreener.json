    {
      "parameters": {
        "promptType": "define",
        "text": "=You are an expert HR assistant.\n\nThe following text is extracted from a resume.\n\n{{ $json.content.parts[0].text }}\n\nExtract:\n\n- Name\n- Email\n- Phone\n- Skills\n- Education\n- Experience\n\nReturn only the extracted information.",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are an expert HR assistant that extracts structured candidate information from resume text."
        }
      },
